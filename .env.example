# =============================================================================
# .env.example — plantilla documentada (SÍ se commitea).
# Copia este archivo a `.env` (públicas) y `.env.local` (secretos) localmente.
# =============================================================================

# --- Públicas (viajan al bundle del cliente) ---
VITE_SUPABASE_PROJECT_ID="tu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_tu-clave"
VITE_SUPABASE_URL="https://tu-project-id.supabase.co"

# --- Duplicados para SSR (server functions / middleware) ---
SUPABASE_PROJECT_ID="tu-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_tu-clave"
SUPABASE_URL="https://tu-project-id.supabase.co"

# --- Secretos (SOLO en .env.local, nunca commiteados) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
GOOGLE_AI_STUDIO_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash